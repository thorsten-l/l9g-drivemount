<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>l9g.app</groupId>
  <artifactId>drivemount</artifactId>
  <version>1.0.1</version>
  <name>L9G DriveMount</name>
  <description>Cross-platform SMB drive mounter - Keycloak Direct Grant (Passwort + TOTP), Share-Liste aus Token-Claim</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A business-friendly OSS license</comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>thorsten-l</id>
      <name>Thorsten Ludewig</name>
      <email>t.ludewig@gmail.com</email>
      <url>https://github.com/thorsten-l</url>
      <roles>
        <role>architect</role>
        <role>developer</role>
      </roles>
      <timezone>Europe/Berlin</timezone>
      <properties>
        <picUrl>https://gravatar.com/avatar/5668953be5f76706e39b626fb8bc28d6</picUrl>
      </properties>
    </developer>
  </developers>

  <properties>
    <java.version>25</java.version>
    <javafx.version>25.0.4</javafx.version>
    <main.class>l9g.app.drivemount.Launcher</main.class>
    <l9g.crypto.version>1.0.7</l9g.crypto.version>
    <!-- Nur fuer spring-boot:process-aot (Native Build), siehe native-Profil -->
    <aot.main.class>l9g.app.drivemount.DrivemountSpring</aot.main.class>
    <build.profile>default</build.profile>
    <exec.inheritIo>true</exec.inheritIo>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    
    <!-- L9G Crypto -->
    <dependency>
      <groupId>de.l9g</groupId>
      <artifactId>crypto-core</artifactId>
      <version>${l9g.crypto.version}</version>
    </dependency>
    <dependency>
      <groupId>de.l9g</groupId>
      <artifactId>crypto-spring</artifactId>
      <version>${l9g.crypto.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>

    <resources>
      <!-- application.yaml.sample ist eine Vorlage fuer Einrichter und hat
           im Artefakt nichts verloren - genau wie LICENSE, das deshalb
           ausserhalb von src/main/resources liegt. -->
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>**/*.sample</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
        <executions>
          <!-- Erzeugt META-INF/build-info.properties; daraus liest die UI die
               Version (BuildProperties). -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Dev-Run: mvn javafx:run (loest JavaFX-Module/Natives sauber auf) -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Native Build (Liberica NIK *Full* als JAVA_HOME erforderlich, enthaelt LibericaFX):
        ./BUILD_NATIVE_MACOS.sh            oder    mvn -Pnative clean package
      Ergebnis: target/${project.artifactId}
      Vorher Reachability-Metadaten per Tracing-Agent erzeugen:
        ./BUILD_NATIVE_MACOS.sh (Option "agent", siehe README)
      Der Spring-Boot-Parent liefert im Profil "native" das Plugin-Management
      (process-aot, add-reachability-metadata, classesDirectory); hier wird nur
      das native-maven-plugin aktiviert und das Binary konfiguriert.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <configuration>
                  <!-- NICHT ueber Launcher: der startet JavaFX und der Build
                  haengt am offenen Login-Fenster. -->
                  <mainClass>${aot.main.class}</mainClass>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <!-- Klassenverzeichnis statt des repackagten Boot-Jars (Main-Klasse laege sonst unter BOOT-INF/) -->
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <imageName>${project.artifactId}</imageName>
              <mainClass>${main.class}</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>--enable-url-protocols=https</buildArg>
                <buildArg>--add-modules</buildArg>
                <buildArg>javafx.controls,javafx.fxml</buildArg>
                <buildArg>-H:IncludeResources=.*\.(fxml|css|png|yaml|yml)$</buildArg>
                <!-- FFM-Downcalls (Windows/macOS-Mounter); je nach NIK-Version anpassen -->
                <buildArg>-H:+ForeignAPISupport</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
