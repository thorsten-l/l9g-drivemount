[Desktop Entry]
Type=Application
Version=1.5
Name=DriveMount
GenericName=Netzlaufwerke verbinden
Comment=SMB-Laufwerke nach Anmeldung mit Passwort und TOTP verbinden
Exec=@EXEC@
Icon=drivemount
Terminal=false
Categories=Network;FileTransfer;Utility;
Keywords=SMB;CIFS;Netzlaufwerk;Laufwerk;Mount;Keycloak;Ostfalia;
StartupNotify=true
# Ohne diesen Eintrag ordnet die GNOME-Leiste das laufende Fenster dem
# Starter nicht zu und zeigt daneben ein zweites, generisches Symbol.
# JavaFX setzt WM_CLASS auf den Namen der ausfuehrbaren Datei.
StartupWMClass=drivemount
