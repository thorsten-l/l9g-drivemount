# Vorlage fuer ./.env - dort stehen die Werte der eigenen Umgebung.
#
#   cp env.sample .env      und die Platzhalter ersetzen
#
# .env steht in .gitignore und geht nicht mit ins Repository. Die Datei
# enthaelt keine Geheimnisse, aber Rechnernamen und Pfade einer konkreten
# Installation - das gehoert nicht in eine oeffentliche Historie.
#
# Gelesen wird sie von den BUILD_*-Skripten ueber load-env.sh. Bereits
# gesetzte Umgebungsvariablen haben Vorrang, ein einmaliges
#
#   WIN_HOST=10.0.0.5 ./BUILD_NATIVE_WINDOWS.sh
#
# sticht also den Eintrag hier. Kommentare nur in eigenen Zeilen.

# ----------------------------------------------------------------- macOS
# Liberica NIK *Full* (mit LibericaFX). Gilt auch auf dem Linux-Rechner,
# weil dort dasselbe Skript laeuft.
NIK_HOME=/opt/nik/25-full

# Signatur des App-Bundles. Leer lassen, dann sucht BUILD_NATIVE_MACOS.sh
# selbst nach einem "Developer ID Application"-Zertifikat im Schluesselbund
# und faellt ohne eines auf eine Ad-hoc-Signatur zurueck. Nur setzen, wenn
# mehrere Zertifikate vorhanden sind und die Auswahl eindeutig sein muss.
MACOS_SIGN_IDENTITY=

# Schluesselbund-Profil fuer die Notarisierung, einmalig angelegt mit
# "xcrun notarytool store-credentials". Das App-spezifische Passwort liegt
# damit im Schluesselbund und nicht hier.
MACOS_NOTARY_PROFILE=drivemount

# --------------------------------------------------------------- Windows
# ssh-Ziel des Windows-Rechners. Ohne diesen Wert bricht
# BUILD_NATIVE_WINDOWS.sh ab - es gibt keine sinnvolle Vorgabe.
WIN_HOST=windows-host.example.org

# Projektverzeichnis drueben. Backslashes, wie Windows sie schreibt.
WIN_PROJECT=C:\Users\builder\Projects\l9g-drivemount

# Ablage fuer die uebertragenen Archive und das PowerShell-Skript.
# Schraegstriche, weil scp Backslashes im entfernten Pfad zerlegt.
WIN_STAGING=C:/Users/builder

# Liberica NIK Full auf dem Windows-Rechner.
WIN_NIK_HOME=C:\Program Files\BellSoft\LibericaNIK-Full-25-OpenJDK-25

# Landet als "CompanyName" in den Versionsinformationen der EXE und ist
# damit in den Dateieigenschaften sichtbar. Leer lassen ist zulaessig und
# hier die Vorgabe: die EXE ist nicht signiert, ein Herausgebername waere
# also eine Behauptung, die niemand pruefen kann.
WIN_COMPANY_NAME=

# ----------------------------------------------------------------- Linux
# ssh-Ziel des Linux-Rechners. Ohne diesen Wert bricht
# BUILD_NATIVE_LINUX.sh ab.
LINUX_HOST=linux-host.example.org

# Projektverzeichnis drueben, relativ zum Home des ssh-Benutzers.
LINUX_PROJECT=Projects/l9g-drivemount

# Liberica NIK Full auf dem Linux-Rechner.
LINUX_NIK_HOME=/opt/nik/25-full
