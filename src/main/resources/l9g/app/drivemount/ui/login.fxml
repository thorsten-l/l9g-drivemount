<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Aufbau wie die Keycloak-Login-Maske: Logo ueber einer weissen Karte auf
  hellgrauem Grund. Farben, Radien und Schriftgroessen stehen in sonia.css,
  eingehaengt in DrivemountApplication#start.
-->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="l9g.app.drivemount.ui.LoginController"
           prefWidth="720" prefHeight="720">

  <VBox spacing="18" alignment="CENTER">
    <padding>
      <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>

    <!-- HBox statt direktem Kind: eine VBox richtet nicht-resizable Knoten
         wie ImageView sonst linksbuendig aus. -->
    <HBox alignment="CENTER">
      <ImageView fitHeight="96" fitWidth="96" preserveRatio="true">
        <image>
          <Image url="@../../../../assets/SONIA-Logo-128h.png"/>
        </image>
      </ImageView>
    </HBox>

    <!-- fx:id, damit der Controller den Verweis "Kontosicherheit verwalten"
         direkt unter dem TOTP-Feld einhaengen kann. Der Knoten entsteht im
         Code und nicht hier: jeder neue Typ im FXML wird reflektiv
         aufgeloest und braucht dann einen Eintrag in den
         Reachability-Metadaten. -->
    <VBox fx:id="card" styleClass="card" spacing="14" maxWidth="470">
      <Label text="Netzlaufwerke verbinden" styleClass="title"/>
      <TextField fx:id="usernameField" promptText="Benutzername"/>
      <PasswordField fx:id="passwordField" promptText="Passwort"/>
      <TextField fx:id="totpField" promptText="TOTP (6-stellig)"/>
      <Button fx:id="loginButton" text="Anmelden und verbinden" onAction="#onLogin"
              defaultButton="true" maxWidth="Infinity"/>
      <Label fx:id="statusLabel" styleClass="status" wrapText="true"/>
      <ListView fx:id="resultList" prefHeight="118"/>
    </VBox>
  </VBox>

  <!-- Unten links im Fenster, nicht in der Karte. Deshalb StackPane als
       Wurzel: eine VBox kann ein Kind nicht unabhaengig vom Fluss
       positionieren. -->
  <Label fx:id="versionLabel" styleClass="version"
         StackPane.alignment="BOTTOM_LEFT"/>
</StackPane>
