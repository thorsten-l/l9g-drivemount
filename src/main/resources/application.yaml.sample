# Vorlage fuer src/main/resources/application.yaml.
#
# Enthaelt bewusst keine produktiven Werte: kein echter IDP, kein Realm,
# kein Client-Secret, keine echten Shares. Zum Einrichten kopieren und die
# Platzhalter ersetzen:
#
#   cp src/main/resources/application.yaml.sample \
#      src/main/resources/application.yaml
#
# Die echte application.yaml gehoert nicht in ein oeffentliches Repository -
# das Client-Secret darin ist zwar verschluesselt, der Schluessel liegt aber
# als assets/secret.bin daneben (siehe unten).

spring:
  main:
    # Kein Webserver - Spring liefert hier nur Dependency Injection und
    # Konfiguration; die Oberflaeche ist JavaFX.
    web-application-type: NONE
    banner-mode: off
  profiles:
    active: default

drivemount:
  keycloak:
    # Basis-URL des Keycloak (ohne /realms/...) und der Realm-Name.
    base-url: https://idp.example.org
    realm: example

    # Client-ID aus der Keycloak-Administration. Der Client braucht einen
    # duplizierten Direct-Grant-Flow mit "direct-grant-validate-otp" auf
    # Required, gebunden ueber Advanced -> Authentication flow overrides
    # (siehe README).
    client-id: drivemount

    # Client-Secret des confidential Clients, verschluesselt durch l9g-crypto.
    # Den Wert erzeugt die Anwendung selbst:
    #
    #   java -jar target/drivemount.jar -e "<klartext-secret>"
    #
    # Die Ausgabe ist der komplette {AES256}-String und kommt hier hinein.
    #
    # WICHTIG: Das ist Verschleierung, kein Schutz. Der Schluessel wird als
    # assets/secret.bin im selben Artefakt ausgeliefert - wer das Binary hat,
    # kommt mechanisch an den Klartext. Das Secret authentifiziert die
    # Anwendung gegenueber Keycloak, nicht den Benutzer; abgesichert wird der
    # Login durch Passwort + TOTP.
    client-secret: "{AES256}HIER_DEN_VERSCHLUESSELTEN_WERT_EINTRAGEN"

  # Aus dieser Mailadresse wird die AD-Domaene abgeleitet: Teil hinter dem
  # "@" ohne TLD, also "vorname.nachname@example.org" -> "example".
  # Keycloak liefert den Standard-Claim "email" nur mit scope=openid email;
  # "mail" wird als Alternative ebenfalls geprueft.
  #
  # Dieselbe Domaene waehlt weiter unten den passenden Block aus "shares"
  # aus - sie ist zugleich der Domaenenanteil der Anmeldung am Fileserver.
  mail-claim: email

  # Fallback, falls im Token keine Mailadresse steht. Muss unten ebenfalls
  # einen Block unter "shares" haben, sonst gibt es fuer solche Benutzer
  # nichts zu verbinden.
  smb-domain: example

  # Wartezeit, bevor sich das Fenster nach erfolgreichem Verbinden ALLER
  # Laufwerke schliesst - lang genug, um die Ergebnisliste zu lesen.
  # "0" schliesst sofort; bei Fehlern bleibt das Fenster ohnehin offen.
  close-delay: 2s

  # Selbstverwaltung des IDP. Ist der Wert gesetzt, zeigt die Login-Maske
  # unter dem TOTP-Feld den Verweis "Kontosicherheit verwalten" und oeffnet
  # ihn im Standardbrowser des Betriebssystems - dort laesst sich zum
  # Beispiel ein neuer Authenticator einrichten, wenn das Einmalkennwort
  # nicht mehr passt. Bei Keycloak ist das der unten stehende Pfad.
  # Weglassen oder leer lassen blendet den Verweis aus.
  account-security-url: https://idp.example.org/realms/example/account/account-security/signing-in

  # Statische Shares, gruppiert nach AD-Domaene. Der Schluessel ist genau
  # das, was oben aus der Mailadresse abgeleitet wird: Teil hinter dem "@"
  # ohne TLD. Aus "a@example.org" wird "example", aus "b@example-zwei.de"
  # wird "example-zwei" - der Bindestrich gehoert dazu, nur die Endung faellt
  # weg. Gross-/Kleinschreibung spielt keine Rolle.
  #
  # Der Benutzername kommt aus dem Login-Dialog, die Domaene aus dem
  # Mail-Claim; zusammen ergibt das die Anmeldung "example\<user>" am
  # Fileserver. "mount" ist der Windows-Laufwerksbuchstabe; unter
  # macOS/Linux ignoriert.
  #
  # Meldet sich jemand aus einer Domaene an, die hier nicht steht, wird
  # nichts verbunden und das Fenster bleibt mit einem Hinweis offen. Das ist
  # Absicht - lieber gar keine Laufwerke als die einer fremden Domaene.
  shares:
    example:
      - label: User Home
        url: smb://fileserver.example.org/home
        mount: H
      - label: Group Share
        url: smb://fileserver.example.org/group
        mount: G
    example-zwei:
      - label: User Home
        url: smb://fileserver.example-zwei.org/home
        mount: H
